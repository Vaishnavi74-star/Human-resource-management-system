# ==========================================
# DAYFLOW - SUPABASE BACKEND CONFIGURATION
# ==========================================

# 1. Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Direct PostgreSQL Database Connection String (for pgAdmin / migrations / backend scripts)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# 4. Optional Service Role Secret (for backend server-side scripts only; never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
